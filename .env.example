PROJECT_NAME=EdgeForge
DEBUG=True

# Set this to the remote GPU PC IP running CARLA.
CARLA_HOST=192.168.1.50
CARLA_PORT=2000
CARLA_TIMEOUT=15.0

API_HOST=127.0.0.1
API_PORT=8000
# Optional comma-separated browser origins for a dashboard on another host.
# EDGEFORGE_CORS_ORIGINS=http://localhost:5173

CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FOV=90
CAMERA_TICK=0.05

RISK_THRESHOLD=0.7
DETECTION_CONFIDENCE_THRESHOLD=0.5

YOLO_MODEL_PATH=yolov8n.pt
YOLO_NMS_IOU=0.7
YOLO_DEVICE=cpu
