# ------------------------------------------------------------------------------
# EdgeForge — root .gitignore
# Place this at the repository ROOT (the folder that CONTAINS .venv and edgeforge/).
# ------------------------------------------------------------------------------

# ---- Python bytecode / caches ------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
*.egg

# ---- Virtual environments ----------------------------------------------------
.venv/
venv/
env/
ENV/
.venv-*/

# ---- Jupyter & IPython -------------------------------------------------------
.ipynb_checkpoints/
.ipython/

# ---- IDEs / editors ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.history/
.trae/

# ---- OS junk -----------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ---- Logs --------------------------------------------------------------------
*.log
logs/
*.log.*

# ---- Testing / coverage ------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
coverage.xml

# ---- Environment & secrets (CRITICAL — never commit real .env files) --------
.env
.env.*
!.env.example

# ---- ML / large data ---------------------------------------------------------
*.pt
*.pth
*.onnx
*.bin
*.h5
*.hdf5
*.parquet
*.zarr
weights/
checkpoints/
datasets/
data/raw/
data/processed/
*.csv
!.github/**/*.csv

# ---- CARLA-specific (CARLA dists are huge — never commit) -------------------
CarlaUE4/
Engine/
Content/
CARLA_*/
*.egg         # the CARLA Python API egg (version-specific)
PythonAPI/
Dist/

# ---- EdgeForge outputs (recorded runs, generated scenarios, etc.) -----------
edgeforge/scenarios/generated/*.json
!edgeforge/scenarios/generated/.gitkeep
edgeforge/runs/
edgeforge/logs/
edgeforge/recordings/
edgeforge/outputs/
edgeforge/metrics/

# ---- Web / Node (if we add a UI package later) ------------------------------
node_modules/
dist/
.cache/
.parcel-cache/
.next/
.nuxt/
