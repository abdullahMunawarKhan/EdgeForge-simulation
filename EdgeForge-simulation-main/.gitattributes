# ------------------------------------------------------------------------------
# Explicitly tell git how to handle each file type (line endings, diffs, …).
# Keeps cross-platform (Windows / macOS / Linux) collaboration clean.
# ------------------------------------------------------------------------------

# --- Default: auto-detect text files and normalize LF on commit ---
* text=auto eol=lf

# --- Python ---
*.py      text diff=python
*.pyi     text

# --- Config / data ---
*.json    text diff=json
*.toml    text
*.yaml    text diff=yaml
*.yml     text diff=yaml
*.ini     text
*.cfg     text
*.env     text eol=lf
*.md      text diff=markdown
*.txt     text
*.csv     text

# --- Web (for future UI layer) ---
*.html    text
*.css     text diff=css
*.js      text diff=javascript
*.ts      text diff=typescript
*.tsx     text diff=typescript

# --- Shell / batch ---
*.sh      text eol=lf
*.ps1     text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# --- True binaries (never diff, never normalize) ---
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.bmp     binary
*.ico     binary
*.webp    binary

*.pb      binary
*.onnx    binary
*.pt      binary
*.pth     binary
*.h5      binary
*.hdf5    binary
*.parquet binary
*.zarr    binary
*.egg     binary
*.dll     binary
*.so      binary
*.dylib   binary
*.exe     binary

*.mp4     binary
*.avi     binary
*.bag     binary   # ROS bags
*.pcap    binary   # LiDAR captures
