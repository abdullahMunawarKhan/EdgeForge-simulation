{
  "name": "basic_urban_scenario",
  "description": "Starter EdgeForge urban driving scenario",
  "version": "1.0",
  "weather": "ClearNoon",
  "map": "Town03",
  "duration_seconds": 60,
  "traffic": {
    "vehicles": 5,
    "pedestrians": 10,
    "bicycles": 2
  },
  "ego_vehicle": {
    "model": "vehicle.tesla.model3",
    "spawn_point_index": 0,
    "speed_limit": 50,
    "autopilot": false
  },
  "sensors": {
    "rgb_camera": {
      "enabled": true,
      "width": 1280,
      "height": 720,
      "fov": 90,
      "tick": 0.05
    },
    "lidar": {
      "enabled": false,
      "channels": 64,
      "points_per_second": 1000000,
      "range": 100
    },
    "imu": {
      "enabled": false
    },
    "gnss": {
      "enabled": false
    },
    "collision": {
      "enabled": true
    },
    "lane_invasion": {
      "enabled": true
    }
  },
  "risk_analysis": {
    "enabled": true,
    "threshold": 0.7
  },
  "notes": [
    "TODO: Add scenario events (sudden braking, pedestrian crossing, cut-in, etc.).",
    "TODO: Add waypoint route for the ego vehicle.",
    "TODO: Add success / failure criteria for scenario evaluation."
  ]
}
