# ---------------------------------------------------------------------------
# EdgeForge – environment-variable template
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values for your environment.
# pydantic-settings will pick them up automatically.
#
# Values commented out use the defaults declared in config/settings.py
# ---------------------------------------------------------------------------

# ---- Project --------------------------------------------------------------
PROJECT_NAME=EdgeForge
# VERSION=0.1.0
DEBUG=True

# ---- CARLA simulator ------------------------------------------------------
CARLA_HOST=127.0.0.1
CARLA_PORT=2000
# CARLA_TIMEOUT=10.0

# ---- Camera ---------------------------------------------------------------
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FOV=90
# CAMERA_TICK=0.05

# ---- Risk analysis --------------------------------------------------------
RISK_THRESHOLD=0.7

# ---- Perception -----------------------------------------------------------
# DETECTION_CONFIDENCE_THRESHOLD=0.5
