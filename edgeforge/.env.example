# ---------------------------------------------------------------------------
# EdgeForge – environment-variable template
# ---------------------------------------------------------------------------
# Copy this file to `.env` at the project root and update the values for your
# local or remote CARLA deployment.
# ---------------------------------------------------------------------------

PROJECT_NAME=EdgeForge
DEBUG=True

# ---- CARLA simulator ------------------------------------------------------
# Update this to the GPU PC that is running CARLA.
CARLA_HOST=192.168.1.50
CARLA_PORT=2000
CARLA_TIMEOUT=15.0

# ---- Camera ---------------------------------------------------------------
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FOV=90
CAMERA_TICK=0.05

# ---- Risk analysis --------------------------------------------------------
RISK_THRESHOLD=0.7
DETECTION_CONFIDENCE_THRESHOLD=0.5

# ---- Perception -----------------------------------------------------------
YOLO_MODEL_PATH=yolov8n.pt
YOLO_NMS_IOU=0.7
YOLO_DEVICE=cpu
