{
  "name": "lowres_quicktest",
  "description": "Ultra-light scenario for low-end / crashing machines – tiny camera, minimal traffic, short run.",
  "version": "1.0",
  "weather": "ClearNoon",
  "map": "Town03",
  "duration_seconds": 30,
  "traffic": {
    "vehicles": 2,
    "pedestrians": 0,
    "bicycles": 0
  },
  "ego_vehicle": {
    "model": "vehicle.tesla.model3",
    "spawn_point_index": 0,
    "speed_limit": 40,
    "autopilot": true
  },
  "sensors": {
    "rgb_camera": {
      "enabled": true,
      "width": 320,
      "height": 240,
      "fov": 90,
      "tick": 0.1
    },
    "lidar":        { "enabled": false },
    "imu":          { "enabled": false },
    "gnss":         { "enabled": false },
    "collision":    { "enabled": true },
    "lane_invasion":{ "enabled": false }
  },
  "risk_analysis": {
    "enabled": true,
    "threshold": 0.7
  }
}
